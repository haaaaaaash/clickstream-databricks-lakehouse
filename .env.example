# Copy to .env and fill in. .env is git-ignored: never commit it.
#
# Names deliberately avoid DATABRICKS_HOST / DATABRICKS_CLIENT_ID / DATABRICKS_CLIENT_SECRET:
# the Databricks CLI reads those automatically and would mix them with admin login.

# Azure 
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=germanywestcentral
AZURE_RESOURCE_GROUP=rg-clickstream
DATABRICKS_WORKSPACE_NAME=dbw-clickstream
AZURE_BUDGET_AMOUNT=5

# Databricks workspace
DATABRICKS_WORKSPACE_URL=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000
DATABRICKS_WAREHOUSE_ID=0000000000000000
DATABRICKS_CLUSTER_POLICY_ID=0000000000000000
DATABRICKS_CATALOG=clickstream
DATABRICKS_ADMIN_PROFILE=clickstream-admin
DATABRICKS_ADMIN_USER=you@example.com

# Service principal used by dbt, Airflow and CI
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
DATABRICKS_SP_CLIENT_ID=00000000-0000-0000-0000-000000000000
DATABRICKS_SP_CLIENT_SECRET='your-secret'

# dbt
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt

